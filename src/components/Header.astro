---
import { CONTACT_EMAIL, GITHUB_URL, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="Primary navigation">
		<h2>
			<a href="/" aria-label={SITE_TITLE}>WU<span>.</span>HAOHAN</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/#projects">Works</HeaderLink>
			<HeaderLink href="/blog">Devlog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
			<a href={`mailto:${CONTACT_EMAIL}`}>Email</a>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1rem;
		background: var(--paper-50);
		border-bottom: var(--border-pixel-thin);
		box-shadow: var(--shadow-hard-sm);
	}
	h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1rem;
		letter-spacing: var(--tracking-pixel-wide);
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	h2 span {
		color: var(--aurora-green);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: var(--nav-max);
		margin: 0 auto;
	}
	nav a {
		padding: 1rem 0.5rem;
		color: var(--ink-900);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--aurora-green);
	}
	nav a:hover {
		color: var(--aurora-green);
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	.social-links,
	.social-links a {
		display: flex;
		align-items: center;
	}
	.social-links {
		gap: 0.5rem;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
		nav {
			align-items: flex-start;
			flex-direction: column;
			padding: 0.75rem 0;
		}
		nav a {
			padding: 0.4rem 0.5rem;
		}
		.internal-links {
			flex-wrap: wrap;
		}
	}
</style>
