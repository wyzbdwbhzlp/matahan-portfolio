---
import { GITHUB_URL } from '../../consts';
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-transparent">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="#hero" class="flex items-center gap-2 group">
            <span class="w-3 h-3 bg-aurora-green rounded-none group-hover:rotate-45 transition-transform duration-300" style="box-shadow: 0 0 8px rgba(74, 222, 128, 0.7);"></span>
            <span class="font-display font-bold text-lg tracking-widest text-ink-900 group-hover:text-aurora-green transition-colors">
                WU<span class="text-aurora-green">.</span>HAOHAN
            </span>
        </a>

        <ul class="hidden md:flex items-center gap-8 text-sm font-medium tracking-wider text-ink-700">
            <li><a href="#projects" class="hover:text-aurora-green transition-colors duration-300" data-i18n="nav.projects">/ 作品</a></li>
            <li><a href="#journey" class="hover:text-aurora-green transition-colors duration-300" data-i18n="nav.journey">/ 旅程</a></li>
            <li><a href="#skills" class="hover:text-aurora-green transition-colors duration-300" data-i18n="nav.skills">/ 灵魂</a></li>
            <li>
                <button id="lang-toggle" class="flex items-center gap-1 px-3 py-2 border-2 border-ink-700/20 hover:border-aurora-green hover:text-aurora-green transition-all duration-300 text-sm font-mono rounded-none" aria-label="Switch language">
                    <span class="lang-toggle-zh text-aurora-green">中</span>
                    <span class="text-ink-400">/</span>
                    <span class="lang-toggle-en text-ink-500">EN</span>
                </button>
            </li>
            <li>
                <a href={GITHUB_URL} target="_blank" rel="noopener" class="flex items-center gap-2 px-4 py-2 border-2 border-ink-700/20 hover:border-aurora-green hover:text-aurora-green transition-all duration-300 rounded-none">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                    GitHub
                </a>
            </li>
        </ul>

        <button id="menu-toggle" class="md:hidden p-2 text-ink-900" aria-label="菜单">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>
    </div>

    <div id="mobile-menu" class="hidden md:hidden bg-white/95 backdrop-blur-md border-t-2 border-aurora-green/20">
        <ul class="px-6 py-4 space-y-3 text-sm text-ink-700">
            <li><a href="#projects" class="block py-2 hover:text-aurora-green transition-colors" data-i18n="nav.projects">/ 作品</a></li>
            <li><a href="#journey" class="block py-2 hover:text-aurora-green transition-colors" data-i18n="nav.journey">/ 旅程</a></li>
            <li><a href="#skills" class="block py-2 hover:text-aurora-green transition-colors" data-i18n="nav.skills">/ 灵魂</a></li>
            <li>
                <button id="lang-toggle-mobile" class="w-full text-left py-2 hover:text-aurora-green transition-colors font-mono">
                    <span class="lang-toggle-zh text-aurora-green">中</span>
                    <span class="text-ink-400 mx-1">/</span>
                    <span class="lang-toggle-en text-ink-500">EN</span>
                </button>
            </li>
            <li><a href={GITHUB_URL} target="_blank" rel="noopener" class="block py-2 text-ink-900">/ GitHub</a></li>
        </ul>
    </div>
</nav>
