---
import { CONTACT_EMAIL, GITHUB_URL } from '../consts';

const today = new Date();
---

<footer>
	<p class="copyright">
		&copy; {today.getFullYear()} Wu Haohan. Crafted for games, code, and small glowing worlds.
	</p>
	<div class="social-links">
		<a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
		<a href={`mailto:${CONTACT_EMAIL}`}>Email</a>
		<a href="/rss.xml">RSS</a>
	</div>
</footer>

<style>
	footer {
		padding: 2rem 1rem 4rem;
		background: var(--paper-50);
		border-top: var(--border-pixel-thin);
		color: var(--ink-600);
		text-align: center;
	}
	.copyright {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-top: 1rem;
		flex-wrap: wrap;
	}
	.social-links a {
		text-decoration: none;
		color: var(--ink-600);
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}
	.social-links a:hover {
		color: var(--aurora-green);
	}
</style>
