---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	pubDate?: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	heroAlt?: string;
	tags?: string[];
	series?: string;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroAlt = '',
	tags = [],
	series,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${title} | Wu Haohan`} description={description} image={heroImage} />
	</head>
	<body>
		<Header />
		<main class="article-page">
			<article>
				<header class="article-header">
					<a class="back-link" href="/blog">&lt;- DEVLOG_INDEX</a>
					{series && <p class="series">// SERIES: {series}</p>}
					<h1>{title}</h1>
					<p class="description">{description}</p>
					{
						pubDate && (
							<div class="article-meta">
								<span>PUBLISHED <FormattedDate date={pubDate} /></span>
								{updatedDate && <span>UPDATED <FormattedDate date={updatedDate} /></span>}
							</div>
						)
					}
					{
						tags.length > 0 && (
							<ul class="article-tags" aria-label="文章标签">
								{tags.map((tag) => <li>{tag}</li>)}
							</ul>
						)
					}
				</header>

				{
					heroImage && (
						<figure class="hero-image">
							<Image width={1200} height={675} src={heroImage} alt={heroAlt} />
						</figure>
					)
				}

				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-page {
		width: min(var(--content-max), calc(100% - 2rem));
		margin: 0 auto;
		padding: clamp(3rem, 8vw, 6rem) 0;
	}
	.article-header {
		width: min(100%, 58rem);
		margin: 0 auto 3rem;
	}
	.back-link,
	.series {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
	}
	.back-link {
		color: var(--ink-500);
		text-decoration: none;
	}
	.back-link:hover {
		color: var(--aurora-green);
	}
	.series {
		margin: 2rem 0 0.75rem;
		color: var(--aurora-violet);
	}
	h1 {
		max-width: 52rem;
		margin: 1.25rem 0;
		font-family: var(--font-display);
		font-size: clamp(2.2rem, 7vw, 4.5rem);
		line-height: 1.05;
		letter-spacing: 0;
	}
	.description {
		max-width: 46rem;
		margin: 0;
		color: var(--ink-500);
		font-size: 1.1rem;
	}
	.article-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		margin-top: 2rem;
		padding: 0.75rem 0;
		border-block: 2px solid var(--ink-900);
		font-family: var(--font-mono);
		font-size: 0.72rem;
	}
	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}
	.article-tags li {
		padding: 0.2rem 0.45rem;
		border: var(--tag-border);
		font-family: var(--font-mono);
		font-size: 0.68rem;
	}
	.hero-image {
		width: min(100%, 68rem);
		margin: 0 auto 4rem;
		border: var(--border-pixel);
		box-shadow: var(--shadow-hard-green);
		background: var(--sky-deep);
	}
	.hero-image :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
	.prose {
		width: min(100%, var(--prose-max));
		margin: 0 auto;
	}
	@media (max-width: 720px) {
		.article-header {
			margin-bottom: 2rem;
		}
		.hero-image {
			margin-bottom: 3rem;
			box-shadow: 5px 5px 0 var(--aurora-green);
		}
	}
</style>
