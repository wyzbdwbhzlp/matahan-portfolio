---
import HomeEffects from '../components/home/HomeEffects.astro';
import HomeFooter from '../components/home/HomeFooter.astro';
import HomeNav from '../components/home/HomeNav.astro';
import HeroSection from '../components/home/HeroSection.astro';
import JourneySection from '../components/home/JourneySection.astro';
import ProjectsSection from '../components/home/ProjectsSection.astro';
import SkillsSection from '../components/home/SkillsSection.astro';
import '../styles/design-tokens.css';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Wu Haohan — 独立游戏开发者 | Indie Game Developer · 用代码与逻辑构建虚拟世界" />
    <title>Wu Haohan | Indie Game Developer</title>

    <!-- ========== 外部依赖:字体 + 预编译 Tailwind ========== -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700&family=Fira+Code:wght@400;600&family=Orbitron:wght@500;700;900&family=Press+Start+2P&family=VT323&family=DotGothic16&family=ZCOOL+QingKe+HuangYou&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS 预编译版(由 ./tailwindcss build 生成,~38KB) -->
    <link rel="stylesheet" href="/tw.css" />
</head>

<body class="relative overflow-x-hidden">
    <!-- ========== 全局交互与 CRT 特效层 ========== -->
    <HomeEffects />

    <!-- ========== 导航栏:固定顶部 ========== -->
    <HomeNav />

    <!-- ========== 首屏 Hero Section:极光夜空 + 像素山剪影 ========== -->
    <HeroSection />

    <!-- ========== 像素云分隔(从黄昏到白底) ========== -->
    <div class="pixel-clouds" aria-hidden="true"></div>

    <!-- ========== 核心独立游戏作品 Selected Projects ========== -->
    <ProjectsSection />

    <!-- ========== 开发者旅程 Journey 时间线 ========== -->
    <JourneySection />

    <!-- ========== 技能与灵魂基底 Skills & Soul ========== -->
    <SkillsSection />

    <!-- ========== 页脚 Footer ========== -->
    <HomeFooter />

    <!-- ========== 交互脚本:由 Astro/Vite 打包 ========== -->
    <script>
        import '../scripts/home';
    </script>
</body>
</html>
