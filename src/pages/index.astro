---
import { journeyItems } from '../data/journey';
import { projects } from '../data/projects';
import { skillPanels } from '../data/skills';
import '../styles/design-tokens.css';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Wu Haohan — 独立游戏开发者 | Indie Game Developer · 用代码与逻辑构建虚拟世界" />
    <title>Wu Haohan | Indie Game Developer</title>

    <!-- ========== 外部依赖:字体 + 预编译 Tailwind ========== -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700&family=Fira+Code:wght@400;600&family=Orbitron:wght@500;700;900&family=Press+Start+2P&family=VT323&family=DotGothic16&family=ZCOOL+QingKe+HuangYou&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS 预编译版(由 ./tailwindcss build 生成,~38KB) -->
    <link rel="stylesheet" href="/tw.css" />
</head>

<body class="relative overflow-x-hidden">
    <!-- ========== 自定义系统光标(桌面端) ========== -->
    <div class="cursor-crosshair" id="cursor-crosshair" aria-hidden="true">
        <div class="cross-line" style="position:absolute; top:50%; left:0; width:100%; height:1px; background:#4ade80;"></div>
        <div class="cross-line" style="position:absolute; left:50%; top:0; width:1px; height:100%; background:#4ade80;"></div>
        <div class="cross-center" style="position:absolute; top:50%; left:50%; width:6px; height:6px; background:#4ade80; transform:translate(-50%,-50%); box-shadow:0 0 8px #4ade80;"></div>
        <span class="click-label">CLICK</span>
    </div>
    <div id="cursor-trail-container" aria-hidden="true"></div>

    <!-- ========== Konami 彩蛋:像素雪崩画布 ========== -->
    <canvas id="matrix-rain" aria-hidden="true"></canvas>
    <div class="konami-banner" id="konami-banner" aria-hidden="true">
        <div class="title">KONAMI CODE</div>
        <div class="subtitle">// developer_mode_unlocked</div>
    </div>

    <!-- ========== 1-bit Adventure 小游戏全屏层 ========== -->
    <div id="adventure-game" class="adventure-game" aria-hidden="true">
        <div class="adventure-hud">
            <span class="adventure-score">SCORE <b id="adv-score">0</b></span>
            <span class="adventure-time">TIME <b id="adv-time">30</b></span>
            <span class="adventure-hint">← → / A D · SPACE 跳 · ESC 退出</span>
        </div>
        <canvas id="adventure-canvas" width="640" height="360"></canvas>
        <div class="adventure-overlay" id="adventure-start">
            <div class="adventure-title">▶ 1-BIT ADVENTURE</div>
            <div class="adventure-sub">按 SPACE 开始 · 跳雪堆 · 躲极光球 · 捡金币</div>
            <div class="adventure-keys">← → 移动 · SPACE 跳跃 · ESC 退出</div>
        </div>
        <div class="adventure-overlay hidden" id="adventure-end">
            <div class="adventure-title" id="adv-end-title">GAME OVER</div>
            <div class="adventure-sub">SCORE <b id="adv-final-score">0</b></div>
            <div class="adventure-keys">SPACE 重玩 · ESC 退出</div>
        </div>
    </div>
    <div class="konami-hint" id="konami-hint" aria-hidden="true">
        Try: <kbd>↑</kbd><kbd>↑</kbd><kbd>↓</kbd><kbd>↓</kbd><kbd>←</kbd><kbd>→</kbd><kbd>←</kbd><kbd>→</kbd><kbd>B</kbd><kbd>A</kbd>
    </div>

    <!-- ========== CRT 扫描线 + 故障渲染覆盖层 ========== -->
    <div class="crt-scanlines" aria-hidden="true"></div>
    <div class="crt-scanband" aria-hidden="true"></div>
    <div class="crt-noise" aria-hidden="true"></div>
    <div class="crt-vignette" aria-hidden="true"></div>
    <div class="crt-glitch" id="crt-glitch" aria-hidden="true"></div>
    <div class="crt-tear" id="crt-tear" aria-hidden="true"></div>

    <div class="scanline"></div>

    <!-- ========== 导航栏:固定顶部 ========== -->
    <nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-transparent">
        <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
            <a href="#hero" class="flex items-center gap-2 group">
                <span class="w-3 h-3 bg-aurora-green rounded-none group-hover:rotate-45 transition-transform duration-300" style="box-shadow: 0 0 8px rgba(74, 222, 128, 0.7);"></span>
                <span class="font-display font-bold text-lg tracking-widest text-ink-900 group-hover:text-aurora-green transition-colors">
                    WU<span class="text-aurora-green">.</span>HAOHAN
                </span>
            </a>

            <ul class="hidden md:flex items-center gap-8 text-sm font-medium tracking-wider text-ink-700">
                <li><a href="#projects" class="hover:text-aurora-green transition-colors duration-300" data-i18n="nav.projects">/ 作品</a></li>
                <li><a href="#journey" class="hover:text-aurora-green transition-colors duration-300" data-i18n="nav.journey">/ 旅程</a></li>
                <li><a href="#skills" class="hover:text-aurora-green transition-colors duration-300" data-i18n="nav.skills">/ 灵魂</a></li>
                <li>
                    <button id="lang-toggle" class="flex items-center gap-1 px-3 py-2 border-2 border-ink-700/20 hover:border-aurora-green hover:text-aurora-green transition-all duration-300 text-sm font-mono rounded-none" aria-label="Switch language">
                        <span class="lang-toggle-zh text-aurora-green">中</span>
                        <span class="text-ink-400">/</span>
                        <span class="lang-toggle-en text-ink-500">EN</span>
                    </button>
                </li>
                <li>
                    <a href="http://github.com/wyzbdwbhzlp" target="_blank" rel="noopener" class="flex items-center gap-2 px-4 py-2 border-2 border-ink-700/20 hover:border-aurora-green hover:text-aurora-green transition-all duration-300 rounded-none">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                        GitHub
                    </a>
                </li>
            </ul>

            <button id="menu-toggle" class="md:hidden p-2 text-ink-900" aria-label="菜单">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
        </div>

        <div id="mobile-menu" class="hidden md:hidden bg-white/95 backdrop-blur-md border-t-2 border-aurora-green/20">
            <ul class="px-6 py-4 space-y-3 text-sm text-ink-700">
                <li><a href="#projects" class="block py-2 hover:text-aurora-green transition-colors" data-i18n="nav.projects">/ 作品</a></li>
                <li><a href="#journey" class="block py-2 hover:text-aurora-green transition-colors" data-i18n="nav.journey">/ 旅程</a></li>
                <li><a href="#skills" class="block py-2 hover:text-aurora-green transition-colors" data-i18n="nav.skills">/ 灵魂</a></li>
                <li>
                    <button id="lang-toggle-mobile" class="w-full text-left py-2 hover:text-aurora-green transition-colors font-mono">
                        <span class="lang-toggle-zh text-aurora-green">中</span>
                        <span class="text-ink-400 mx-1">/</span>
                        <span class="lang-toggle-en text-ink-500">EN</span>
                    </button>
                </li>
                <li><a href="http://github.com/wyzbdwbhzlp" target="_blank" rel="noopener" class="block py-2 text-ink-900">/ GitHub</a></li>
            </ul>
        </div>
    </nav>

    <!-- ========== 首屏 Hero Section:极光夜空 + 像素山剪影 ========== -->
    <section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden celeste-sky">
        <!-- 极光细丝层(漂动装饰) -->
        <div class="aurora-curtain" aria-hidden="true"></div>

        <!-- 星座连线 SVG(6 条流光线,连 13 颗星点) -->
        <svg class="constellation" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <g stroke="#ffffff" stroke-width="0.12" stroke-linecap="round" fill="none" opacity="0.45">
                <!-- 腰带 + 上肩:星点 1→3→5→7,1→3,3→11 -->
                <line x1="8" y1="4" x2="28" y2="5" />
                <line x1="28" y1="5" x2="40" y2="11" />
                <line x1="40" y1="11" x2="52" y2="3" />
                <line x1="52" y1="3" x2="76" y2="5" />
                <line x1="76" y1="5" x2="95" y2="4" />
                <line x1="35" y1="17" x2="58" y2="14" />
            </g>
            <!-- 流光:每条线一个 dot 沿 path 移动 -->
            <g fill="#d1fae5">
                <circle r="0.6" opacity="0.9">
                    <animate attributeName="cx" values="8;28;40;52;76;95" dur="11s" repeatCount="indefinite" />
                    <animate attributeName="cy" values="4;5;11;3;5;4" dur="11s" repeatCount="indefinite" />
                </circle>
                <circle r="0.5" fill="#a7f3d0" opacity="0.9">
                    <animate attributeName="cx" values="35;58" dur="8s" repeatCount="indefinite" />
                    <animate attributeName="cy" values="17;14" dur="8s" repeatCount="indefinite" />
                </circle>
                <circle r="0.4" fill="#c7d2fe" opacity="0.8">
                    <animate attributeName="cx" values="28;40;52" dur="7s" repeatCount="indefinite" />
                    <animate attributeName="cy" values="5;11;3" dur="7s" repeatCount="indefinite" />
                </circle>
            </g>
        </svg>

        <!-- 像素雪粒子层(8-bit 风,极光夜空下飘雪) -->
        <div class="pixel-snow" id="pixel-snow" aria-hidden="true"></div>

        <!-- 像素山剪影(2 层,极光夜空下用深蓝/近黑) -->
        <div class="celeste-mountains" aria-hidden="true">
            <!-- 远山(午夜深蓝) -->
            <svg viewBox="0 0 1200 200" preserveAspectRatio="none" style="height: 60%;">
                <polygon fill="#0a1228" points="0,200 80,140 140,160 220,90 320,130 400,100 480,140 560,110 660,150 760,80 840,130 940,100 1040,140 1120,110 1200,140 1200,200"/>
            </svg>
            <!-- 近山(近黑) -->
            <svg viewBox="0 0 1200 200" preserveAspectRatio="none" style="height: 100%;">
                <polygon fill="#020610" points="0,200 60,180 140,150 240,170 340,130 440,160 540,140 640,170 760,150 860,180 960,160 1080,180 1200,160 1200,200"/>
            </svg>
        </div>

        <div class="relative z-10 max-w-5xl mx-auto px-6 py-32 text-center">

            <!-- 名字:WHH 三色字母 + 副名 -->
            <h1 class="font-display font-black tracking-tighter mb-3 reveal">
                <span class="whh-name"><span class="whh-letter">W</span><span class="whh-letter">H</span><span class="whh-letter">H</span></span>
            </h1>
            <p class="text-aurora-mist/55 font-pixel text-xs sm:text-sm tracking-[0.2em] mb-6 reveal" style="transition-delay:0.05s;">WU · HAOHAN</p>

            <!-- 定位:Indie Game Developer 居中(无框无斜杠) -->
            <div class="flex items-center justify-center mb-8 reveal" style="transition-delay: 0.1s;">
                <span class="font-pixel text-sm sm:text-lg tracking-[0.15em] text-aurora-mist/85 uppercase" data-i18n="hero.tag1">Indie Game Developer</span>
            </div>

            <!-- 打字机效果:三行 slogan(中文用 DotGothic16/ZCOOL QingKe HuangYou 像素感回退) -->
            <div class="max-w-3xl mx-auto mb-12 reveal" style="transition-delay: 0.2s;" id="hero-typewriter-wrap">
                <p class="font-pixel text-sm sm:text-base md:text-lg celeste-hero-text leading-relaxed mb-2" id="tw-line-1"></p>
                <p class="font-pixel text-sm sm:text-base md:text-lg text-aurora-mist/80 leading-relaxed mb-2" id="tw-line-2"></p>
                <p class="font-pixel text-sm sm:text-base md:text-lg text-aurora-mist/60 leading-relaxed" id="tw-line-3"></p>
                <noscript>
                    <p class="font-pixel text-sm sm:text-base md:text-lg celeste-hero-text leading-relaxed mb-2" data-i18n="hero.line1">用代码写诗,用逻辑造梦。</p>
                    <p class="font-pixel text-sm sm:text-base md:text-lg text-aurora-mist/80 leading-relaxed mb-2" data-i18n="hero.line2">从 Game Jam 的灵光一闪,到触碰人心的虚拟世界。</p>
                    <p class="font-pixel text-sm sm:text-base md:text-lg text-aurora-mist/60 leading-relaxed" data-i18n="hero.line3">我不只是在做游戏,我在构建我所热爱的宇宙。</p>
                </noscript>
            </div>

            <!-- CTA 按钮 -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 reveal font-pixel text-xs sm:text-sm" style="transition-delay: 0.5s;">
                <a href="#projects" class="btn-primary">
                    <span data-i18n="cta.projects">探索我的宇宙 (Projects)</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </a>
                <a href="#journey" class="btn-secondary">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span data-i18n="cta.journey">我的旅程 (Journey)</span>
                </a>
            </div>

            <div class="absolute bottom-8 left-1/2 -translate-x-1/2 reveal" style="transition-delay: 0.7s;">
                <div class="flex flex-col items-center gap-2 text-aurora-mist/70 text-xs animate-float">
                    <span data-i18n="hero.scroll">SCROLL DOWN</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Hero 装饰按钮:1-bit 游戏入口 + 极光 ambient 音(下移避开 fixed nav) -->
        <div class="absolute top-24 right-6 z-30 flex flex-col gap-2 reveal" style="transition-delay: 1s;">
            <button id="start-adventure" type="button" aria-label="开始 1-bit 冒险游戏"
                class="px-3 py-2 bg-black/60 border-2 border-aurora-green text-aurora-green font-pixel text-xs hover:bg-aurora-green hover:text-black transition-colors flex items-center gap-2">
                <span>▶</span><span>START</span>
            </button>
            <button id="audio-toggle" type="button" aria-label="开关极光环境音"
                class="px-3 py-2 bg-black/60 border-2 border-aurora-mist/40 text-aurora-mist/80 font-pixel text-xs hover:border-aurora-green hover:text-aurora-green transition-colors flex items-center gap-2">
                <span id="audio-icon">🔇</span><span>AURORA</span>
            </button>
        </div>
    </section>

    <!-- ========== 像素云分隔(从黄昏到白底) ========== -->
    <div class="pixel-clouds" aria-hidden="true"></div>

    <!-- ========== 核心独立游戏作品 Selected Projects ========== -->
    <section id="projects" class="relative py-24 md:py-32 bg-paper-50/50">
        <div class="max-w-6xl mx-auto px-6">
            <div class="mb-16 reveal">
                <div class="flex items-center gap-3 mb-3">
                    <span class="text-aurora-green font-pixel text-sm font-semibold">01.</span>
                    <h2 class="font-pixel pixel-h2 text-base sm:text-lg md:text-xl text-ink-900">
                        <span class="ember-text">▍</span> <span data-i18n="proj.heading">SELECTED WORKS</span>
                    </h2>
                </div>
                <p class="text-ink-500 ml-12 font-pixel text-xs sm:text-sm" data-i18n="proj.subtitle">四颗心,从 Game Jam 走到展会 · Code &amp; Soul</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
                {projects.map((project) => (
                    <div class="card-3d">
                        <article
                            class:list={[
                                'glass-card p-6 md:p-8 group reveal card-3d-inner relative overflow-hidden',
                                project.cardModifier,
                            ]}
                            style={project.transitionDelay ? `transition-delay: ${project.transitionDelay};` : undefined}
                        >
                            <div class="flex items-center justify-between mb-4">
                                <div class="flex items-center gap-2">
                                    <span class:list={['w-2 h-2 rounded-none animate-pulse', project.pulseClass]}></span>
                                    <span class="text-xs text-ink-500 font-mono">{project.fileLabel}</span>
                                </div>
                                <span class={project.status.className} data-i18n={project.status.i18nKey}>
                                    {project.status.fallback}
                                </span>
                            </div>

                            <div class="relative h-44 mb-6 border-4 border-ink-900 overflow-hidden pixel-thumb flex items-center justify-center">
                                <div class="relative z-10 text-center">
                                    <div class="font-pixel text-2xl text-ink-900 mb-3">{project.icon}</div>
                                    <div class="text-[9px] text-aurora-green font-pixel">{project.visualLabel}</div>
                                </div>
                                <span class="absolute top-2 left-2 text-[10px] text-ink-900 font-pixel">┌─</span>
                                <span class="absolute top-2 right-2 text-[10px] text-ink-900 font-pixel">─┐</span>
                                <span class="absolute bottom-2 left-2 text-[10px] text-ink-900 font-pixel">└─</span>
                                <span class="absolute bottom-2 right-2 text-[10px] text-ink-900 font-pixel">─┘</span>
                            </div>

                            <div class="flex flex-wrap gap-2 mb-3">
                                {project.tags.map((tag) => (
                                    <span class:list={['tag', tag.className]} data-i18n={tag.i18nKey}>
                                        {tag.fallback}
                                    </span>
                                ))}
                            </div>

                            <h3 class="font-mono font-bold text-lg sm:text-xl text-ink-900 mb-3 group-hover:text-aurora-green transition-colors uppercase tracking-tight">
                                <span data-i18n={project.title.i18nKey}>{project.title.fallback}</span>
                                {project.title.suffix && <span class="text-ink-500 text-lg"> {project.title.suffix}</span>}
                            </h3>

                            <p
                                class="text-ink-600 leading-relaxed text-xs sm:text-sm mb-4 font-pixel"
                                data-i18n={project.description.i18nKey}
                                set:html={project.description.fallbackHtml}
                            />

                            <div class="pt-4 border-t-2 border-ink-700/10 flex items-center justify-between text-xs font-mono text-ink-500">
                                <span>// STACK</span>
                                <span data-i18n={project.stack.i18nKey}>{project.stack.fallback}</span>
                            </div>

                            <div class="card-shine"></div>
                        </article>
                    </div>
                ))}

            </div>
        </div>
    </section>

    <!-- ========== 开发者旅程 Journey 时间线 ========== -->
    <section id="journey" class="relative py-24 md:py-32">
        <div class="max-w-6xl mx-auto px-6">
            <div class="mb-16 reveal">
                <div class="flex items-center gap-3 mb-3 flex-wrap">
                    <span class="text-aurora-green font-pixel text-sm font-semibold">02.</span>
                    <h2 class="font-pixel pixel-h2 text-base sm:text-lg md:text-xl text-ink-900">
                        <span class="ember-text">▍</span> <span data-i18n="journey.heading">THE JOURNEY</span>
                    </h2>
                </div>
                <p class="text-ink-500 ml-12 font-pixel text-xs sm:text-sm" data-i18n="journey.subtitle">从灵光一现到触碰人心 · 仍在继续</p>
            </div>

            <div class="relative">
                <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-1 -translate-x-1/2 pixel-axis" aria-hidden="true"></div>
                <!-- 时间线流光光标(极光绿 4x4 像素亮点,自动循环扫描) -->
                <div class="timeline-cursor hidden md:block" aria-hidden="true"></div>

                {journeyItems.map((item, index) => (
                    <div class:list={['relative reveal', index < journeyItems.length - 1 && 'mb-12 md:mb-16']}>
                        <div class:list={['timeline-node', item.nodeClass]} style="top: 0.5rem;"></div>

                        <div class="md:grid md:grid-cols-2 md:gap-12">
                            <div class={item.dateColumnClass}>
                                <div class:list={['inline-block md:block', item.dateInnerClass]}>
                                    <div class={item.dateClass} data-i18n={item.date.i18nKey}>
                                        {item.date.fallback}
                                    </div>
                                    <div class="text-ink-500 text-xs sm:text-sm mt-1 font-pixel" data-i18n={item.status.i18nKey}>
                                        {item.status.fallback}
                                    </div>
                                </div>
                            </div>
                            <div class={item.cardColumnClass}>
                                <div class={item.cardInnerClass}>
                                    <div class={item.cardClass}>
                                        <div class="flex flex-wrap items-center gap-2 mb-3">
                                            {item.tags.map((tag) => (
                                                <span class:list={['tag', tag.className]} data-i18n={tag.i18nKey}>
                                                    {tag.fallback}
                                                </span>
                                            ))}
                                        </div>
                                        <h3
                                            class="font-mono font-bold text-base md:text-lg text-ink-900 mb-2 uppercase tracking-tight"
                                            data-i18n={item.title.i18nKey}
                                        >
                                            {item.title.fallback}
                                        </h3>
                                        <p
                                            class="text-ink-600 leading-relaxed text-xs sm:text-sm md:text-base font-pixel"
                                            data-i18n={item.description.i18nKey}
                                            set:html={item.description.fallbackHtml}
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                ))}

            </div>
        </div>
    </section>

    <!-- ========== 技能与灵魂基底 Skills & Soul ========== -->
    <section id="skills" class="relative py-24 md:py-32 bg-paper-50/50">
        <div class="max-w-6xl mx-auto px-6">
            <div class="mb-16 reveal">
                <div class="flex items-center gap-3 mb-3">
                    <span class="text-aurora-green font-pixel text-sm font-semibold">03.</span>
                    <h2 class="font-pixel pixel-h2 text-base sm:text-lg md:text-xl text-ink-900">
                        <span class="ember-text">▍</span> <span data-i18n="skills.heading">SKILLS &amp; SOUL</span>
                    </h2>
                </div>
                <p class="text-ink-500 ml-12 font-pixel text-xs sm:text-sm" data-i18n="skills.subtitle">开发利器 × 独立之魂 × 艺术触觉</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8">
                {skillPanels.map((panel) => (
                    <div
                        class={panel.cardClass}
                        style={panel.transitionDelay ? `transition-delay: ${panel.transitionDelay};` : undefined}
                    >
                        <div class="flex items-center gap-3 mb-6">
                            <div class="w-10 h-10 border-2 border-ink-700/15 bg-white flex items-center justify-center">
                                <svg class="w-5 h-5 text-ink-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    {panel.iconPaths.map((path) => (
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={path} />
                                    ))}
                                </svg>
                            </div>
                            <h3 class="font-mono font-bold text-base text-ink-900 uppercase tracking-wide" data-i18n={panel.title.i18nKey}>
                                {panel.title.fallback}
                            </h3>
                        </div>

                        {panel.bars && (
                            <div class="space-y-5">
                                {panel.bars.map((bar) => (
                                    <div>
                                        <div class="flex items-center justify-between mb-2 text-sm">
                                            <span class="text-ink-800 font-medium">{bar.name}</span>
                                            <span class="text-aurora-green font-mono text-xs font-semibold">{bar.value}%</span>
                                        </div>
                                        <div class="skill-bar"><div class="skill-bar-fill" data-width={`${bar.value}%`}></div></div>
                                    </div>
                                ))}
                            </div>
                        )}

                        {panel.tags && (
                            <div class="flex flex-wrap gap-2.5">
                                {panel.tags.map((tag) => (
                                    <span class:list={['tag', tag.className]} data-i18n={tag.i18nKey}>
                                        {tag.fallback}
                                    </span>
                                ))}
                            </div>
                        )}

                        {panel.note && (
                            <div class="mt-6 pt-6 border-t-2 border-ink-700/10">
                                <p
                                    class="text-xs text-ink-500 font-pixel leading-relaxed"
                                    data-i18n={panel.note.i18nKey}
                                    set:html={panel.note.fallbackHtml}
                                />
                            </div>
                        )}
                    </div>
                ))}

            </div>
        </div>
    </section>

    <!-- ========== 页脚 Footer ========== -->
    <footer class="relative py-12 border-t-2 border-aurora-green/30 bg-paper-50/50">
        <div class="max-w-6xl mx-auto px-6">
            <div class="flex flex-col md:flex-row items-center justify-between gap-6">

                <div class="text-center md:text-left">
                    <div class="font-display font-bold text-lg mb-1">
                        <span class="text-ink-900">WU</span><span class="text-aurora-green">.</span><span class="text-ink-900">HAOHAN</span>
                    </div>
                    <p class="text-ink-500 text-xs font-mono" data-i18n="footer.copyright">
                        © 2026 Wu Haohan. Crafted with <span class="text-aurora-green">♥</span> · Hosted on <a href="https://matahan.com" class="text-ink-800 hover:text-aurora-green transition-colors underline-offset-4 hover:underline">matahan.com</a>.
                    </p>
                </div>

                <div class="flex items-center gap-3">
                    <a href="http://github.com/wyzbdwbhzlp" target="_blank" rel="noopener" class="group flex items-center gap-2 px-4 py-2 border-2 border-ink-700/20 hover:border-aurora-green hover:text-aurora-green transition-all duration-300 rounded-none">
                        <svg class="w-4 h-4 text-ink-500 group-hover:text-aurora-green transition-colors" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                        </svg>
                        <span class="text-xs font-mono group-hover:text-aurora-green transition-colors">GitHub</span>
                    </a>
                    <a href="mailto:wyzbdwbhzlp@outlook.com" class="group flex items-center gap-2 px-4 py-2 border-2 border-ink-700/20 hover:border-aurora-green hover:text-aurora-green transition-all duration-300 rounded-none">
                        <svg class="w-4 h-4 text-ink-500 group-hover:text-aurora-green transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                        <span class="text-xs font-mono group-hover:text-aurora-green transition-colors">Email</span>
                    </a>
                </div>
            </div>

            <div class="mt-8 pt-6 border-t-2 border-aurora-green/20 text-center">
                <p class="text-xs text-ink-500 font-mono" data-i18n="footer.signature">
                    <span class="text-aurora-green font-semibold">$</span> echo "Games are the highest form of art."
                    <span class="animate-blink text-aurora-green">▊</span>
                </p>
            </div>
        </div>
    </footer>

    <!-- ========== 交互脚本 ========== -->
    <script src="/main.js" defer></script>
</body>
